          "description": "Blob creation timestamp"
        },
        "deleted": {
          "type": "boolean",
          "description": "Whether the blob is soft-deleted"
        },
        "deletedTime": {
          "type": "string",
          "format": "date-time",
          "description": "Soft-delete timestamp if applicable"
        },
        "remainingRetentionDays": {
          "type": "integer",
          "description": "Days remaining until permanent deletion (soft-delete)"
        },
        "metadata{}": {
          "type": "object",
          "description": "User-defined metadata key-value pairs on the blob"
        },
        "AccountName": {
          "type": "string",
          "description": "Azure Storage account name (add-on metadata)"
        },
        "ContainerName": {
          "type": "string",
          "description": "Container name (add-on metadata - may mirror container field)"
        }
      },
      "required": [
        "name",
        "container"
      ],
      "additionalProperties": true
    },
    "blobXmlEvent": {
      "title": "Azure Storage Blob -- mscs:storage:blob:xml",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services Azure Blob Storage event, sourcetype mscs:storage:blob:xml. Blob metadata event for an XML-content blob. When sourcetype is mscs:storage:blob:xml XML elements and attributes are extracted as fields (configurable via props.conf)",
      "properties": {
        "name": {
          "type": "string",
          "description": "Blob name (path within the container)"
        },
        "container": {
          "type": "string",
