        },
        "accessTier": {
          "type": "string",
          "description": "Access tier (Hot Cool Archive Cold) if applicable"
        },
        "accessTierInferred": {
          "type": "boolean",
          "description": "Whether the access tier was inferred"
        },
        "accessTierChangeTime": {
          "type": "string",
