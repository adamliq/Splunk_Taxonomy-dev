        },
        "correlationId / CorrelationId": {
          "type": "string",
          "description": "Correlation identifier linking related events"
        },
        "identity / identity.claims": {
          "type": "object",
          "description": "Identity that performed the operation (claims principalId etc.)"
        },
        "properties": {
          "type": "object",
          "description": "Category-specific detailed properties payload"
        },
        "durationMs": {
          "type": "integer",
          "description": "Duration of the operation in milliseconds when present"
        },
        "location / Location": {
          "type": "string",
          "description": "Azure region or geographic location"
        },
        "tenantId / TenantId": {
          "type": "string",
          "description": "Entra ID tenant ID when present"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID parsed from resourceId or event"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group parsed from resourceId when available"
        },
        "userPrincipalName / userDisplayName": {
          "type": "string",
          "description": "User identity"
        },
        "appId / appDisplayName": {
          "type": "string",
          "description": "Application ID and display name"
        },
        "ipAddress": {
          "type": "string",
          "description": "Client IP address"
        },
        "location": {
          "type": "object",
          "description": "Geographic location of the sign-in"
        },
        "status": {
          "type": "object",
          "description": "Sign-in status (errorCode failureReason)"
        },
        "deviceDetail": {
          "type": "object",
          "description": "Device information"
        },
        "clientAppUsed": {
          "type": "string",
          "description": "Client application used"
        },
        "conditionalAccessStatus": {
          "type": "string",
          "description": "Conditional Access result"
        },
        "riskDetail / riskLevelAggregated / riskLevelDuringSignIn": {
          "type": "string",
          "description": "Identity Protection risk signals"
        },
        "EventHub": {
          "type": "string",
          "description": "Event Hub name (add-on / system metadata)"
        },
        "ConsumerGroup": {
          "type": "string",
          "description": "Consumer group used for ingestion"
        },
        "PartitionId": {
          "type": "string",
          "description": "Event Hub partition ID"
        },
        "Offset / SequenceNumber": {
          "anyOf": [
            {
