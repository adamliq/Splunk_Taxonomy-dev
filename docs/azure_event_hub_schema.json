{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adamliq.github.io/Splunk_Taxonomy-dev/docs/azure_event_hub_schema.json",
  "title": "Azure Event Hub events",
  "description": "Field schema for the Splunk Add-on for Microsoft Cloud Services Event Hub input, covering the generic Event Hub sourcetype and the Azure Monitor / Entra ID / security-alert content variants commonly streamed through it. Every branch also carries the Event Hub transport metadata fields (EventHub, ConsumerGroup, PartitionId, Offset / SequenceNumber) the add-on attaches regardless of payload content.",
  "$defs": {
    "eventHubEvent": {
      "title": "Azure Event Hub -- mscs:azure:eventhub",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services Event Hub-delivered event, sourcetype mscs:azure:eventhub. Generic Event Hub-delivered event using only the common Azure Monitor-style envelope fields.",
      "properties": {
        "time / timeGenerated / TimeGenerated": {
          "type": "string",
          "format": "date-time",
          "description": "Event timestamp (UTC)"
        },
        "resourceId / _ResourceId": {
          "type": "string",
          "description": "Full ARM resource ID associated with the event"
        },
        "operationName": {
          "type": "string",
          "description": "Name of the operation that generated the event"
        },
        "category": {
          "type": "string",
          "description": "Log category (e.g. Administrative Security AuditLogs SignInLogs)"
        },
        "resultType / Level / status": {
          "type": "string",
          "description": "Result or severity (Success Failure Critical Error Warning Informational)"
        },
        "resultDescription / ResultDescription": {
          "type": "string",
          "description": "Text description of the result"
        },
        "callerIpAddress / CallerIpAddress": {
          "type": "string",
          "description": "Source IP address of the caller"
        },
        "correlationId / CorrelationId": {
          "type": "string",
          "description": "Correlation identifier linking related events"
        },
        "identity / identity.claims": {
          "type": "object",
          "description": "Identity that performed the operation (claims principalId etc.)"
        },
        "properties": {
          "type": "object",
          "description": "Category-specific detailed properties payload"
        },
        "durationMs": {
          "type": "integer",
          "description": "Duration of the operation in milliseconds when present"
        },
        "location / Location": {
          "type": "string",
          "description": "Azure region or geographic location"
        },
        "tenantId / TenantId": {
          "type": "string",
          "description": "Entra ID tenant ID when present"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID parsed from resourceId or event"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group parsed from resourceId when available"
        },
        "EventHub": {
          "type": "string",
          "description": "Event Hub name (add-on / system metadata)"
        },
        "ConsumerGroup": {
          "type": "string",
          "description": "Consumer group used for ingestion"
        },
        "PartitionId": {
          "type": "string",
          "description": "Event Hub partition ID"
        },
        "Offset / SequenceNumber": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "Event position within the partition"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "activityLogEvent": {
      "title": "Azure Event Hub -- azure:monitor:activity",
