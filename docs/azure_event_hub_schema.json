        }
      },
      "required": [],
      "additionalProperties": true
    },
    "resourceLogEvent": {
      "title": "Azure Event Hub -- azure:monitor:resource",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services Event Hub-delivered event, sourcetype azure:monitor:resource. Resource-provider diagnostic log delivered via Event Hub.",
      "properties": {
        "time / timeGenerated / TimeGenerated": {
          "type": "string",
          "format": "date-time",
          "description": "Event timestamp (UTC)"
        },
        "resourceId / _ResourceId": {
          "type": "string",
          "description": "Full ARM resource ID associated with the event"
        },
        "operationName": {
          "type": "string",
          "description": "Name of the operation that generated the event"
        },
        "category": {
          "type": "string",
          "description": "Resource log category specific to the resource provider"
        },
        "resultType / Level / status": {
          "type": "string",
          "description": "Result or severity (Success Failure Critical Error Warning Informational)"
        },
        "resultDescription / ResultDescription": {
          "type": "string",
          "description": "Text description of the result"
        },
        "callerIpAddress / CallerIpAddress": {
          "type": "string",
          "description": "Source IP address of the caller"
        },
        "correlationId / CorrelationId": {
          "type": "string",
          "description": "Correlation identifier linking related events"
        },
        "identity / identity.claims": {
          "type": "object",
          "description": "Identity that performed the operation (claims principalId etc.)"
        },
        "properties": {
          "type": "object",
          "description": "Provider-specific log details"
        },
        "durationMs": {
          "type": "integer",
          "description": "Duration of the operation in milliseconds when present"
        },
        "location / Location": {
          "type": "string",
          "description": "Azure region or geographic location"
        },
        "tenantId / TenantId": {
