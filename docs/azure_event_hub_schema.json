        "resultType / Level / status": {
          "type": "string",
          "description": "Result or severity (Success Failure Critical Error Warning Informational)"
        },
        "resultDescription / ResultDescription": {
          "type": "string",
          "description": "Text description of the result"
        },
        "callerIpAddress / CallerIpAddress": {
          "type": "string",
          "description": "Source IP address of the caller"
        },
        "correlationId / CorrelationId": {
          "type": "string",
          "description": "Correlation identifier linking related events"
        },
        "identity / identity.claims": {
          "type": "object",
          "description": "Identity that performed the operation (claims principalId etc.)"
        },
        "properties": {
          "type": "object",
          "description": "Category-specific detailed properties payload"
        },
        "durationMs": {
          "type": "integer",
          "description": "Duration of the operation in milliseconds when present"
        },
        "location / Location": {
          "type": "string",
          "description": "Azure region or geographic location"
        },
        "tenantId / TenantId": {
          "type": "string",
          "description": "Entra ID tenant ID when present"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID parsed from resourceId or event"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group parsed from resourceId when available"
        },
        "eventTimestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Activity log event time"
        },
        "operationName.value": {
          "type": "string",
          "description": "Fully qualified operation name"
        },
        "status.value": {
          "type": "string",
          "description": "Operation status (Succeeded Failed etc.)"
        },
        "caller": {
          "type": "string",
          "description": "Caller identity (UPN or application ID)"
        },
        "eventDataId": {
          "type": "string",
          "description": "Unique activity log event ID"
        },
        "level": {
          "type": "string",
          "description": "Event level"
        },
        "subStatus": {
          "type": "string",
          "description": "Sub-status code or message"
        },
        "EventHub": {
          "type": "string",
          "description": "Event Hub name (add-on / system metadata)"
        },
        "ConsumerGroup": {
          "type": "string",
          "description": "Consumer group used for ingestion"
        },
        "PartitionId": {
          "type": "string",
          "description": "Event Hub partition ID"
        },
        "Offset / SequenceNumber": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "Event position within the partition"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "aadEvent": {
      "title": "Azure Event Hub -- azure:monitor:aad",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services Event Hub-delivered event, sourcetype azure:monitor:aad. Entra ID (Azure AD) sign-in/audit event delivered via Event Hub.",
