      "required": [],
      "additionalProperties": true
    },
    "securityAlertEvent": {
      "title": "Azure Event Hub -- mscs:azure:security:alert",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services Event Hub-delivered event, sourcetype mscs:azure:security:alert. Microsoft Defender for Cloud security alert delivered via Event Hub; does not use the azure:monitor:* common envelope fields since it is a distinct sourcetype family.",
      "properties": {
        "alertDisplayName": {
          "type": "string",
          "description": "Human-readable alert title"
        },
        "severity": {
          "type": "string",
          "description": "Alert severity (High Medium Low Informational)"
        },
        "status": {
          "type": "string",
          "description": "Alert status"
        },
        "compromisedEntity": {
          "type": "string",
          "description": "Primary compromised entity"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Related entities (hosts accounts files IPs)"
        },
        "remediationSteps": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ],
          "description": "Recommended remediation actions"
        },
        "EventHub": {
          "type": "string",
          "description": "Event Hub name (add-on / system metadata)"
        },
        "ConsumerGroup": {
          "type": "string",
