{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adamliq.github.io/Splunk_Taxonomy-dev/docs/azure_resource_manager_schema.json",
  "title": "Azure Resource Manager (mscs:resource:*) events",
  "description": "Field schema for the Splunk Add-on for Microsoft Cloud Services generic ARM resource inventory input (\"Azure Resource\"), covering the ten mscs:resource:* sourcetype variants documented for this collector.",
  "$defs": {
    "vmResourceEvent": {
      "title": "Azure Resource -- virtualMachine",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:virtualMachine.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name / vm_name": {
          "type": "string",
          "description": "Virtual machine name"
        },
        "type": {
          "type": "string",
          "description": "Resource type (Microsoft.Compute/virtualMachines)"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "vm_size": {
          "type": "string",
          "description": "VM size/SKU (e.g. Standard_D2s_v3)"
        },
        "power_state": {
          "type": "string",
          "description": "Power state (running stopped deallocated etc.)"
        },
        "osType": {
          "type": "string",
          "description": "Operating system type (Windows Linux)"
        },
        "cpu_cores": {
          "type": "integer",
          "description": "Number of CPU cores (enriched)"
        },
        "mem_capacity": {
          "type": "integer",
          "description": "Memory capacity in bytes (enriched)"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group name"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        },
        "properties.storageProfile": {
          "type": "object",
          "description": "OS disk and data disk configuration"
        },
        "properties.hardwareProfile": {
          "type": "object",
          "description": "Hardware profile including vmSize"
        },
        "properties.networkProfile": {
          "type": "object",
          "description": "Network interfaces configuration"
        },
        "properties.osProfile": {
          "type": "object",
          "description": "OS profile (computerName adminUsername etc.)"
        },
        "properties.instanceView": {
          "type": "object",
          "description": "Runtime instance view (statuses extensions etc.)"
        },
        "properties.provisioningState": {
          "type": "string",
          "description": "Provisioning state"
        }
      },
      "required": [
        "id",
        "location",
        "resourceGroup",
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "nicResourceEvent": {
      "title": "Azure Resource -- networkInterfaceCard",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:networkInterfaceCard.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name": {
          "type": "string",
          "description": "Network interface name"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "macAddress": {
          "type": "string",
          "description": "MAC address"
        },
        "ipConfigurations{}": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "IP configurations (private IP public IP subnet)"
        },
        "networkSecurityGroup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ],
          "description": "Associated NSG reference"
        },
        "virtualMachine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ],
          "description": "Associated VM reference"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group name"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "resourceGroup",
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "publicIpResourceEvent": {
      "title": "Azure Resource -- publicIPAddress",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:publicIPAddress.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name": {
          "type": "string",
          "description": "Public IP name"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "ipAddress": {
          "type": "string",
          "description": "Allocated public IP address"
        },
        "publicIPAllocationMethod": {
          "type": "string",
          "description": "Static or Dynamic"
        },
        "publicIPAddressVersion": {
          "type": "string",
          "description": "IPv4 or IPv6"
        },
        "dnsSettings": {
          "type": "object",
          "description": "DNS settings (domainNameLabel fqdn)"
        },
        "sku": {
          "type": "object",
          "description": "SKU (Basic Standard)"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group name"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "resourceGroup",
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "virtualNetworkResourceEvent": {
      "title": "Azure Resource -- virtualNetwork",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:virtualNetwork.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name": {
          "type": "string",
          "description": "Virtual network name"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "addressSpace": {
          "type": "object",
          "description": "Address space prefixes"
        },
        "subnets{}": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Subnet definitions"
        },
        "dhcpOptions": {
          "type": "object",
          "description": "DHCP options (DNS servers)"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group name"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "resourceGroup",
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "diskResourceEvent": {
      "title": "Azure Resource -- disk",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:disk.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name": {
          "type": "string",
          "description": "Disk name"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "diskSizeGB": {
          "type": "integer",
          "description": "Disk size in GB"
        },
        "osType": {
          "type": "string",
          "description": "OS type if OS disk (Windows Linux)"
        },
        "sku": {
          "type": "object",
          "description": "Disk SKU (Standard_LRS Premium_LRS etc.)"
        },
        "managedBy": {
          "type": "string",
          "description": "VM that owns the disk (if attached)"
        },
        "timeCreated": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "creationData": {
          "type": "object",
          "description": "Creation source (empty Image Snapshot etc.)"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group name"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "resourceGroup",
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "imageResourceEvent": {
      "title": "Azure Resource -- image",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:image.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name": {
          "type": "string",
          "description": "Image name"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "storageProfile": {
          "type": "object",
          "description": "OS and data disk storage profile"
        },
        "hyperVGeneration": {
          "type": "string",
          "description": "Hyper-V generation (V1 V2)"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group name"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "resourceGroup",
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "snapshotResourceEvent": {
      "title": "Azure Resource -- snapshot",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:snapshot.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name": {
          "type": "string",
          "description": "Snapshot name"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "diskSizeGB": {
          "type": "integer",
          "description": "Snapshot size in GB"
        },
        "creationData": {
          "type": "object",
          "description": "Source disk or snapshot reference"
        },
        "timeCreated": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "osType": {
          "type": "string",
          "description": "OS type if applicable"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group name"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "resourceGroup",
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "resourceGroupResourceEvent": {
      "title": "Azure Resource -- resourceGroup",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:resourceGroup.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name": {
          "type": "string",
          "description": "Resource group name"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "properties.provisioningState": {
          "type": "string",
          "description": "Provisioning state"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "subscriptionResourceEvent": {
      "title": "Azure Resource -- subscriptions",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:subscriptions.",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "displayName": {
          "type": "string",
          "description": "Subscription display name"
        },
        "state": {
          "type": "string",
          "description": "Subscription state (Enabled Warned etc.)"
        },
        "tenantId": {
          "type": "string",
          "description": "Entra ID tenant ID"
        },
        "subscriptionPolicies": {
          "type": "object",
          "description": "Subscription policies"
        }
      },
      "required": [
        "subscriptionId"
      ],
      "additionalProperties": true
    },
    "securityGroupResourceEvent": {
      "title": "Azure Resource -- securityGroup",
      "type": "object",
      "description": "Splunk Add-on for Microsoft Cloud Services ARM resource event, sourcetype mscs:resource:securityGroup.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Full ARM resource ID"
        },
        "name": {
          "type": "string",
          "description": "Network security group name"
        },
        "location": {
          "type": "string",
          "description": "Azure region"
        },
        "securityRules{}": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Custom security rules"
        },
        "defaultSecurityRules{}": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Default security rules"
        },
        "networkInterfaces": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Associated network interfaces"
        },
        "subnets": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Associated subnets"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group name"
        },
        "subscriptionId": {
          "type": "string",
          "description": "Subscription ID"
        },
        "tags{}": {
          "type": "object",
          "description": "Resource tags"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "resourceGroup",
        "subscriptionId"
      ],
      "additionalProperties": true
    }
  }
}
